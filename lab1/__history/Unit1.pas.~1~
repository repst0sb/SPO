unit Unit1;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls;

type
  TForm1 = class(TForm)
    memCode: TMemo;
    memResult: TMemo;
    btnAnalyze: TButton;
    btnLoadFile: TButton;
    OpenDialog1: TOpenDialog;
    procedure btnAnalyzeClick(Sender: TObject);
    procedure btnLoadFileClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    function CountOperators(const CodeText: string): Integer;
    procedure AnalyzeGilb(const CodeText: string; out AbsoluteCL, OperatorsN, MaxCLI: Integer; out RelativeCL: Double);
  public
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}

procedure TForm1.FormCreate(Sender: TObject);
begin
  // Настройки окна
  Caption := 'Анализатор метрик Джилба';
  ClientWidth := 720;
  ClientHeight := 620;
  Position := poScreenCenter;

  // Диалог выбора файла
  OpenDialog1.Filter := 'Файлы Swift (*.swift;*.txt)|*.swift;*.txt|Все файлы (*.*)|*.*';

  // --- КООРДИНАТЫ И РАЗМЕРЫ ЭЛЕМЕНТОВ НА ФОРМЕ ---

  // 1. Поле для ввода анализируемого кода
  memCode.Left := 15;
  memCode.Top := 15;
  memCode.Width := 690;
  memCode.Height := 240;
  memCode.ScrollBars := ssVertical;
  memCode.Clear; // Поле изначально пустое

  // 2. Кнопка "Загрузить файл"
  btnLoadFile.Left := 15;
  btnLoadFile.Top := 265;
  btnLoadFile.Width := 160;
  btnLoadFile.Height := 35;
  btnLoadFile.Caption := 'Загрузить файл';

  // 3. Кнопка "Рассчитать метрики"
  btnAnalyze.Left := 185;
  btnAnalyze.Top := 265;
  btnAnalyze.Width := 200;
  btnAnalyze.Height := 35;
  btnAnalyze.Caption := 'Рассчитать метрики';

  // 4. Поле для вывода результатов
  memResult.Left := 15;
  memResult.Top := 310;
  memResult.Width := 690;
  memResult.Height := 285;
  memResult.ReadOnly := True;
  memResult.ScrollBars := ssVertical;
  memResult.Clear;
end;

procedure TForm1.btnLoadFileClick(Sender: TObject);
begin
  if OpenDialog1.Execute then
    memCode.Lines.LoadFromFile(OpenDialog1.FileName);
end;

// Подсчет операторов N по точкам с запятой ';' (по спецификации языка)
function TForm1.CountOperators(const CodeText: string): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to Length(CodeText) do
  begin
    if CodeText[i] = ';' then
      Inc(Result);
  end;
  if Result = 0 then Result := 1; // Защита от деления на ноль
end;

// Построчный анализ структуры и расчет метрик Джилба
procedure TForm1.AnalyzeGilb(const CodeText: string; out AbsoluteCL, OperatorsN, MaxCLI: Integer; out RelativeCL: Double);
var
  Lines: TStringList;
  i: Integer;
  Line, TrimmedLine: string;
  CurrentDepth: Integer;
  InCase: Boolean;
  CaseBranchCount: Integer; // Объявлен счётчик веток case
begin
  Lines := TStringList.Create;
  try
    Lines.Text := CodeText;
    AbsoluteCL := 0;
    MaxCLI := 0;
    CurrentDepth := 0;
    InCase := False;
    CaseBranchCount := 0;

    for i := 0 to Lines.Count - 1 do
    begin
      Line := LowerCase(Lines[i]);
      TrimmedLine := Trim(Line);

      // Пропуск пустых строк и комментариев
      if (TrimmedLine = '') or (Pos('//', TrimmedLine) = 1) or (Pos('{', TrimmedLine) = 1) then
        Continue;

      // 1. Ветвления (if / guard)
      if (Pos('if ', TrimmedLine) = 1) or (Pos(' if ', Line) > 0) or (Pos('if(', Line) > 0) then
      begin
        Inc(AbsoluteCL);
        Inc(CurrentDepth);
      end;

      // 2. Циклы (for, while, repeat, until)
      if (Pos('for ', TrimmedLine) = 1) or (Pos(' for ', Line) > 0) or
         (Pos('while ', TrimmedLine) = 1) or (Pos(' while ', Line) > 0) or
         (Pos('repeat', TrimmedLine) = 1) or (Pos('until ', TrimmedLine) = 1) then
      begin
        Inc(AbsoluteCL);
        Inc(CurrentDepth);
      end;

      // 3. Оператор выбора (case / switch)
      if (Pos('case ', TrimmedLine) = 1) or (Pos(' case ', Line) > 0) or (Pos('switch', Line) > 0) then
      begin
        InCase := True;
        CaseBranchCount := 0;
        Continue; // Селектор не является условием!
      end;

      // Обработка внутри блока case
      if InCase then
      begin
        // Если строка содержит двоеточие и не является else/default/end
        if (Pos(':', TrimmedLine) > 0) and
           (Pos('else', TrimmedLine) <> 1) and
           (Pos('default', TrimmedLine) <> 1) and
           (Pos('end', TrimmedLine) <> 1) then
        begin
          Inc(AbsoluteCL);        // Каждая ветка = +1 к абсолютной сложности
          Inc(CaseBranchCount);   // Каждая новая ветка увеличивает глубину
        end;

        // Завершение блока case
        if (Pos('end;', TrimmedLine) = 1) or (TrimmedLine = 'end') or (TrimmedLine = '}') then
        begin
          InCase := False;
          CurrentDepth := CurrentDepth + CaseBranchCount - 1;
          if CurrentDepth < 0 then CurrentDepth := 0;
          CaseBranchCount := 0;
        end;
      end;

      // Фиксируем максимальный уровень вложенности CLI
      if (CurrentDepth + CaseBranchCount) > MaxCLI then
        MaxCLI := CurrentDepth + CaseBranchCount;

      // Уменьшаем глубину при закрытии стандартных блоков end / }
      if (TrimmedLine = 'end;') or (TrimmedLine = 'end') or (TrimmedLine = '}') then
      begin
        if CurrentDepth > 0 then
          Dec(CurrentDepth);
      end;
    end;

    // Расчет метрик
    OperatorsN := CountOperators(CodeText);
    RelativeCL := AbsoluteCL / OperatorsN;

    // Основное математическое свойство метрик Джилба: AbsoluteCL >= MaxCLI
    if MaxCLI > AbsoluteCL then
      MaxCLI := AbsoluteCL;

  finally
    Lines.Free;
  end;
end;

procedure TForm1.btnAnalyzeClick(Sender: TObject);
var
  CL, N, CLI: Integer;
  cl_rel: Double;
begin
  AnalyzeGilb(memCode.Lines.Text, CL, N, CLI, cl_rel);

  memResult.Clear;
  memResult.Lines.Add('=== РЕЗУЛЬТАТЫ АНАЛИЗА МЕТРИК ДЖИЛБА ===');
  memResult.Lines.Add('');
  memResult.Lines.Add(Format('1. Абсолютная сложность (CL):           %d', [CL]));
  memResult.Lines.Add(Format('2. Общее количество операторов (N):     %d', [N]));
  memResult.Lines.Add(Format('3. Относительная сложность (cl = CL/N): %.3f', [cl_rel]));
  memResult.Lines.Add(Format('4. Максимальная вложенность (CLI):      %d', [CLI]));
  memResult.Lines.Add('');
  memResult.Lines.Add('=========================================');

  if CL >= CLI then
    memResult.Lines.Add('Проверка пройдна: CL >= CLI')
  else
    memResult.Lines.Add('Ошибка: Вложенность превышает абсолютную сложность!');
end;

end.
