unit Unit1;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls;

type
  TForm1 = class(TForm)
    memCode: TMemo;
    memResult: TMemo;
    btnAnalyze: TButton;
    btnLoadFile: TButton;
    OpenDialog1: TOpenDialog;
    procedure btnAnalyzeClick(Sender: TObject);
    procedure btnLoadFileClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    function CountOperators(const CodeText: string): Integer;
    procedure AnalyzeGilb(const CodeText: string; out AbsoluteCL, OperatorsN, MaxCLI: Integer; out RelativeCL: Double);
  public
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}

procedure TForm1.FormCreate(Sender: TObject);
begin
  Caption := 'Анализатор метрик Джилба';
  ClientWidth := 720;
  ClientHeight := 620;
  Position := poScreenCenter;

  OpenDialog1.Filter := 'Файлы Swift (*.swift;*.txt)|*.swift;*.txt|Все файлы (*.*)|*.*';

  memCode.Left := 15;
  memCode.Top := 15;
  memCode.Width := 690;
  memCode.Height := 240;
  memCode.ScrollBars := ssVertical;
  memCode.Clear;

  btnLoadFile.Left := 15;
  btnLoadFile.Top := 265;
  btnLoadFile.Width := 160;
  btnLoadFile.Height := 35;
  btnLoadFile.Caption := 'Загрузить файл';

  btnAnalyze.Left := 185;
  btnAnalyze.Top := 265;
  btnAnalyze.Width := 200;
  btnAnalyze.Height := 35;
  btnAnalyze.Caption := 'Рассчитать метрики';

  memResult.Left := 15;
  memResult.Top := 310;
  memResult.Width := 690;
  memResult.Height := 285;
  memResult.ReadOnly := True;
  memResult.ScrollBars := ssVertical;
  memResult.Clear;
end;

procedure TForm1.btnLoadFileClick(Sender: TObject);
begin
  if OpenDialog1.Execute then
    memCode.Lines.LoadFromFile(OpenDialog1.FileName);
end;

// Подсчет операторов N по точкам с запятой ';' (по спецификации языка)
function TForm1.CountOperators(const CodeText: string): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to Length(CodeText) do
  begin
    if CodeText[i] = ';' then
      Inc(Result);
  end;
  if Result = 0 then Result := 1; // Защита от деления на ноль
end;

// Построчный анализ структуры и расчет метрик Джилба (Адаптировано для Swift и Delphi)
procedure TForm1.AnalyzeGilb(const CodeText: string; out AbsoluteCL, OperatorsN, MaxCLI: Integer; out RelativeCL: Double);
var
  Lines: TStringList;
  i, TempDepth: Integer;
  Line, TrimmedLine: string;
  CurrentDepth: Integer;
  InCase: Boolean;
  CaseBranchCount: Integer;
begin
  Lines := TStringList.Create;
  try
    Lines.Text := CodeText;
    AbsoluteCL := 0;
    MaxCLI := 0;
    CurrentDepth := 0;
    InCase := False;
    CaseBranchCount := 0;

    for i := 0 to Lines.Count - 1 do
    begin
      Line := LowerCase(Lines[i]);
      TrimmedLine := Trim(Line);

      // Пропуск пустых строк и комментариев
      if (TrimmedLine = '') or (Pos('//', TrimmedLine) = 1) or (Pos('{', TrimmedLine) = 1) then
        Continue;

      // 1. Ветвления (if)
      if (Pos('if ', TrimmedLine) = 1) or (Pos(' if ', Line) > 0) or (Pos('if(', Line) > 0) then
      begin
        Inc(AbsoluteCL);
        Inc(CurrentDepth);
      end;

      // 2. Циклы (for, repeat, until) - while вынесен отдельно
      if (Pos('for ', TrimmedLine) = 1) or (Pos(' for ', Line) > 0) or
         (Pos('repeat', TrimmedLine) = 1) or (Pos('until ', TrimmedLine) = 1) then
      begin
        Inc(AbsoluteCL);
        Inc(CurrentDepth);
      end;

      // Отдельная проверка while, чтобы не считать закрывающий "} while" в Swift как новый цикл
      if ((Pos('while ', TrimmedLine) = 1) or (Pos(' while ', Line) > 0)) and (Pos('} while', TrimmedLine) <> 1) then
      begin
        Inc(AbsoluteCL);
        Inc(CurrentDepth);
      end;

      // 3. Оператор выбора (switch в Swift, case .. of в Delphi)
      if (Pos('switch', TrimmedLine) = 1) or ((Pos('case ', TrimmedLine) = 1) and (Pos('of', TrimmedLine) > 0)) then
      begin
        InCase := True;
        CaseBranchCount := 0;
        Continue; // Сам селектор условий не проверяет
      end;

      // Обработка внутри блока switch / case
      if InCase then
      begin
        // Ищем ветки с двоеточием, игнорируем default
        if (Pos(':', TrimmedLine) > 0) and (Pos('default', TrimmedLine) <> 1) and (Pos('else', TrimmedLine) <> 1) then
        begin
          Inc(AbsoluteCL);        // Каждая ветка = +1 к абсолютной сложности
          Inc(CaseBranchCount);

          // По Джилбу: n разветвлений эквивалентно глубине вложенности n-2
          if CaseBranchCount > 2 then
            TempDepth := CurrentDepth + CaseBranchCount - 2
          else
            TempDepth := CurrentDepth + 1;

          if TempDepth > MaxCLI then
            MaxCLI := TempDepth;
        end;

        // Выход из блока switch / case
        if (Pos('end', TrimmedLine) = 1) or (Pos('}', TrimmedLine) = 1) then
        begin
          InCase := False;
          CaseBranchCount := 0;
        end;
      end;

      // Фиксируем максимальный уровень вложенности для обычных блоков
      if CurrentDepth > MaxCLI then
        MaxCLI := CurrentDepth;

      // Уменьшаем глубину при закрытии блоков (end или })
      if (Pos('end', TrimmedLine) = 1) or (Pos('}', TrimmedLine) = 1) then
      begin
        if CurrentDepth > 0 then
          Dec(CurrentDepth);
      end;
    end;

    // Расчет параметров
    OperatorsN := CountOperators(CodeText);
    RelativeCL := AbsoluteCL / OperatorsN;

    // Главное правило Джилба: Абсолютная сложность всегда >= Вложенности
    if MaxCLI > AbsoluteCL then
      MaxCLI := AbsoluteCL;

  finally
    Lines.Free;
  end;
end;

procedure TForm1.btnAnalyzeClick(Sender: TObject);
var
  CL, N, CLI: Integer;
  cl_rel: Double;
begin
  AnalyzeGilb(memCode.Lines.Text, CL, N, CLI, cl_rel);

  memResult.Clear;
  memResult.Lines.Add('=== РЕЗУЛЬТАТЫ АНАЛИЗА МЕТРИК ДЖИЛБА ===');
  memResult.Lines.Add('');
  memResult.Lines.Add(Format('1. Абсолютная сложность (CL):           %d', [CL]));
  memResult.Lines.Add(Format('2. Общее количество операторов (N):     %d', [N]));
  memResult.Lines.Add(Format('3. Относительная сложность (cl = CL/N): %.3f', [cl_rel]));
  memResult.Lines.Add(Format('4. Максимальная вложенность (CLI):      %d', [CLI]));
  memResult.Lines.Add('');
  memResult.Lines.Add('=========================================');

  if CL >= CLI then
    memResult.Lines.Add('Проверка пройдна: CL >= CLI')
  else
    memResult.Lines.Add('Ошибка: Вложенность превышает абсолютную сложность!');
end;

end.
